msgstr "Hoy · %H:%M"

#: sign/gui/home.c:69
msgid "Yesterday · %H:%M"
msgstr "Ayer · %H:%M"

#: sign/gui/home.c:73
msgid "Unknown date"
msgstr "Fecha desconocida"

#: sign/gui/home.c:578
msgid "Document"
msgstr "Documento"

#: sign/gui/home.c:582
msgid "Signed"
msgstr "Firmado"

#: sign/gui/home.c:853
msgid "No matching documents"
msgstr "No se encontraron documentos"

#: sign/gui/home.c:998
msgid ""
"The document history could not be read. It may be invalid or exceed its size "
"limit."
msgstr ""
"No se pudo leer el historial de documentos. Puede contener datos no válidos "
"o superar el límite de tamaño."

#: sign/gui/home.c:1019
msgid "Favorites"
msgstr "Favoritos"

#: sign/gui/home.c:1027 sign/gui/home.c:1041 sign/gui/home.c:1110
msgid "Show more"
msgstr "Mostrar más"

#: sign/gui/home.c:1032
msgid "Recent"
msgstr "Recientes"

#: sign/gui/home.c:1055
msgid "Search signed documents"
msgstr "Buscar documentos firmados"

#: sign/gui/home.c:1070
msgid "Search by document name"
msgstr "Buscar por nombre del documento"

#: sign/gui/file_actions.c:70
msgid "Could not open file location"
msgstr "No se pudo abrir la ubicación del archivo"

#: sign/gui/file_actions.c:71
msgid ""
"The containing folder could not be opened. Check that it still exists and "
"that you have permission to access it."
msgstr ""
"No se pudo abrir la carpeta del archivo. Comprueba que exista y que tengas "
"permiso para acceder a ella."

#: sign/gui/file_actions.c:107
msgid "Could not open file"
msgstr "No se pudo abrir el archivo"

#: sign/gui/file_actions.c:108
msgid ""
"The file could not be opened with the default application. Check that it "
"still exists and that an application is available for this file type."
msgstr ""
"No se pudo abrir el archivo con la aplicación predeterminada. Comprueba que "
"siga existiendo y que haya una aplicación disponible para este tipo de "
"archivo."

#: sign/gui/file_actions.c:215 sign/gui/file_actions.c:364
msgid "Open file location"
msgstr "Abrir ubicación del archivo"

#: sign/gui/file_actions.c:217 sign/gui/file_actions.c:378
msgid "Favorite"
msgstr "Favorito"

