#include <winver.h>
1 24 "@PROJECT_SOURCE_DIR@/packaging/windows.manifest"
2 ICON "@SIGN_WINDOWS_ICON@"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SIGN_RESOURCE_VERSION@,0
 PRODUCTVERSION @SIGN_RESOURCE_VERSION@,0
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "CRSign"
      VALUE "FileDescription", "Sign digital signing and verification"
      VALUE "FileVersion", "@SIGN_VERSION@"
      VALUE "ProductName", "CRSign"
      VALUE "ProductVersion", "@SIGN_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
