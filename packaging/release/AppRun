#!/bin/sh
set -eu
APPDIR=${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}
export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export OPENSSL_MODULES="${OPENSSL_MODULES:-$APPDIR/usr/lib/ossl-modules}"
if [ "$#" -eq 0 ]; then
    set -- --gui
fi
exec "$APPDIR/usr/bin/sign" "$@"
